<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Platforms>AnyCPU;x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>

		<!--Add the rumble install path to your computer's environment variables. -->
		<RumblePath>$(Rumble)</RumblePath>
	</PropertyGroup>

	<ItemGroup>
		<!-- Melonloader/il2cpp stuff -->
		<RumbleGameAssemblies Include="$(RumblePath)\MelonLoader\net6\**\*.dll" />
		<RumbleGameAssemblies Include="$(RumblePath)\MelonLoader\net35\**\*.dll" />
		<RumbleGameAssemblies Include="$(RumblePath)\MelonLoader\Il2CppAssemblies\**\*.dll" />

		<!-- Expand Wildcards -->
		<Reference Include="@(RumbleGameAssemblies)" Private="false" />

		<Reference Include="$(RumblePath)\Mods\OBS_Control_API.dll"/>
		<Reference Include="$(RumblePath)\Mods\RumbleModdingAPI.dll"/>
		<Reference Include="$(RumblePath)\Mods\UIFramework.dll"/>
	</ItemGroup>

	<!--Kill Rumble before building-->
	<Target Name="PreBuild" AfterTargets="PreBuildEvent">
		<Exec Command="taskkill /f /t /im RUMBLE.exe 2&gt;NUL | echo killed rumble" />
	</Target>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<!-- Copy dll to Rumble Mods directory -->
		<Exec Command="COPY &quot;$(TargetPath)&quot; &quot;$(RumblePath)\Mods&quot;" />
		
		<!-- Copy to Thunderstore package -->
		<Exec Command="COPY &quot;$(TargetPath)&quot; &quot;$(ProjectDir)_Misc\ThunderstorePackage\Mods&quot;" />
		<Exec Command="COPY &quot;$(ProjectDir)README.md&quot; &quot;$(ProjectDir)_Misc\ThunderstorePackage\&quot;" />
	</Target>
</Project>